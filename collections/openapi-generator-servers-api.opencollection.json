{
  "opencollection": "1.0.0",
  "info": {
    "name": "OpenAPI Generator Online Servers API",
    "version": "7.12.0"
  },
  "items": [
    {
      "info": {
        "name": "servers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Downloads a pre-generated file",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.openapi-generator.tech/api/gen/download/:fileId",
            "params": [
              {
                "name": "fileId",
                "value": "",
                "type": "path",
                "description": "fileId"
              }
            ]
          },
          "docs": "A valid `fileId` is generated by the `/clients/{language}` or `/servers/{language}` POST operations.  The fileId code can be used just once, after which a new `fileId` will need to be requested."
        },
        {
          "info": {
            "name": "Gets languages supported by the server generator",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.openapi-generator.tech/api/gen/servers"
          },
          "docs": "Gets languages supported by the server generator"
        },
        {
          "info": {
            "name": "Returns options for a server framework",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.openapi-generator.tech/api/gen/servers/:framework",
            "params": [
              {
                "name": "framework",
                "value": "",
                "type": "path",
                "description": "The target language for the server framework"
              }
            ]
          },
          "docs": "Returns options for a server framework"
        },
        {
          "info": {
            "name": "Generates a server library",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.openapi-generator.tech/api/gen/servers/:framework",
            "params": [
              {
                "name": "framework",
                "value": "",
                "type": "path",
                "description": "framework"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Accepts a `GeneratorInput` options map for spec location and generation options."
        }
      ]
    }
  ],
  "bundled": true
}